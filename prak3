def encode(data_bits):
    d1, d2, d3, d4 = (int(x) for x in data_bits)
    p1 = d1 ^ d2 ^ d4
    p2 = d1 ^ d3 ^ d4
    p4 = d2 ^ d3 ^ d4
    code = [p1, p2, d1, p4, d2, d3, d4]
    return ''.join(str(x) for x in code)

def syndrome(code_bits):
    b = [int(x) for x in code_bits]
    s1 = b[0] ^ b[2] ^ b[4] ^ b[6]
    s2 = b[1] ^ b[2] ^ b[5] ^ b[6]
    s4 = b[3] ^ b[4] ^ b[5] ^ b[6]
    return s1 * 1 + s2 * 2 + s4 * 4

def correct(code_bits):
    b = [int(x) for x in code_bits]
    pos = syndrome(code_bits)
    if pos != 0:
        b[pos - 1] ^= 1
    return ''.join(str(x) for x in b)

data = "1011"
code = encode(data)

broken = list(code)
if broken[4] == '1':
    broken[4] = '0'
else:
    broken[4] = '1'
broken = ''.join(broken)

syn = syndrome(broken)
fixed = correct(broken)

print(data)#входное сообщение
print(code)#зашифровали сообщение
