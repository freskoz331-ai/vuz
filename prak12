def f(a, b, c):
    return (a or b) or c
def f1(a, b, c):
    return a and b or c
print('f = (a or b) or c')
print('f1 = a and b or c')
print('x', 'y', 'z', '  f')
fres = []
f1res = []
for x in [0,1]:
    for y in [0,1]:
        for z in [0,1]:
            fres.append(f(x, y, z))
            print(x, y, z, ' ', f(x, y, z))
print('  ')
print('x', 'y', 'z', '  f1')
for x1 in [0,1]:
    for y1 in [0,1]:
        for z1 in [0,1]:
            f1res.append(f1(x1, y1, z1))
            print(x1, y1, z1, ' ', f1(x1, y1, z1,))
print('выводы', fres)
print('      ', f1res)
fla = 0
for i in range(len(fres)):
    if fres[i] == f1res[i]:
        fla += 0
    if fres[i] != f1res[i]:
        fla += 1
if fla == 0:
    print('выражения эквивалентны')
else:
    print('выражения не эквивалентны')

